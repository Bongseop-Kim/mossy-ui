---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import PropsTable from '../../components/PropsTable.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import {
  componentPages,
  componentSidebar,
  hasMossyMatch,
  markdownInlineToHtml,
  type ComponentPage,
} from '../../data/seed-parity';

export function getStaticPaths() {
  return componentPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: ComponentPage;
}

const { page } = Astro.props;
const mossyRows = page.rows.filter(hasMossyMatch).length;
const tokenMappings =
  page.name === 'Box'
    ? [
        {
          prop: '`bg`, `background`',
          seedType: '`ScopedColorPalette | ScopedColorBg | ScopedColorBanner | (string & {})`',
          mossyType: '`MossyBoxBackground`',
          mapping: 'Mossy background/palette/banner color token',
          docs: '/design-tokens/#color-token-scopes',
        },
        {
          prop: '`borderColor`',
          seedType: '`ScopedColorPalette | ScopedColorStroke | (string & {})`',
          mossyType: '`MossyBoxBorderColor`',
          mapping: 'Mossy stroke/palette color token',
          docs: '/design-tokens/#color-token-scopes',
        },
        {
          prop: '`borderRadius`',
          seedType: '`Radius | 0 | (string & {})`',
          mossyType: '`MossyBoxRadiusToken | 0`',
          mapping: 'Mossy radius token',
          docs: '/design-tokens/#scale-tokens',
        },
        {
          prop: '`boxShadow`',
          seedType: '`Shadow | (string & {})`',
          mossyType: '`MossyBoxShadow`',
          mapping: 'Mossy shadow/elevation token',
          docs: '/design-tokens/#scale-tokens',
        },
        {
          prop: '`width`, `height`',
          seedType: '`Dimension | spacingX.* | spacingY.* | "full" | (string & {})`',
          mossyType: '`MossyBoxLength`',
          mapping: 'Mossy dimension/spacing token + `full`',
          docs: '/design-tokens/#scale-tokens',
        },
        {
          prop: '`padding*`, `p`, `px`, `py`, `pt`, `pr`, `pb`, `pl`',
          seedType: '`Dimension | spacingX.* | spacingY.* | 0 | (string & {})`',
          mossyType: '`MossyBoxPadding`',
          mapping: 'Mossy dimension/spacing token',
          docs: '/design-tokens/#scale-tokens',
        },
      ]
    : [];
const frontmatter = {
  title: page.name,
  description: `${page.name} Seed Design 참고 구현 대비 mossy-ui Props parity.`,
};
---

<StarlightPage
  frontmatter={frontmatter}
  sidebar={componentSidebar}
  headings={[
    { depth: 2, slug: 'props', text: 'Props' },
    ...(tokenMappings.length > 0
      ? [{ depth: 2 as const, slug: 'seed-mossy-token-mapping', text: 'Seed ↔ Mossy token mapping' }]
      : []),
    { depth: 2, slug: 'next-action', text: 'Next Action' },
    { depth: 2, slug: 'memo', text: 'Memo' },
  ]}
>
  <div class="component-hero">
    <div>
      <p class="eyebrow">Expo UI component parity</p>
      <h1>{page.name}</h1>
      <p>
        {page.rows.length}개 checklist row · Mossy 대응 {mossyRows}/{page.rows.length} · props 완료{' '}
        {page.progress.done}/{page.progress.total}
      </p>
    </div>
    <StatusBadge status={page.status} />
  </div>

  <AnchorHeading level="2" id="props">Props</AnchorHeading>
  <PropsTable rows={page.rows} />

  {
    tokenMappings.length > 0 ? (
      <>
        <AnchorHeading level="2" id="seed-mossy-token-mapping">
          Seed ↔ Mossy token mapping
        </AnchorHeading>
        <div class="props-table-wrap">
          <table class="props-table token-mapping-table">
            <thead>
              <tr>
                <th>Prop</th>
                <th>Seed type union</th>
                <th>Mossy public type</th>
                <th>Mossy token mapping</th>
                <th>Token docs</th>
              </tr>
            </thead>
            <tbody>
              {tokenMappings.map((item) => (
                <tr>
                  <td set:html={markdownInlineToHtml(item.prop)} />
                  <td set:html={markdownInlineToHtml(item.seedType)} />
                  <td set:html={markdownInlineToHtml(item.mossyType)} />
                  <td set:html={markdownInlineToHtml(item.mapping)} />
                  <td>
                    <a href={item.docs}>/design-tokens/</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ) : null
  }

  <AnchorHeading level="2" id="next-action">Next Action</AnchorHeading>
  <div class="note-stack">
    {
      page.rows.map((row) => (
        <section class="note-panel">
          <strong set:html={markdownInlineToHtml(row.seed)} />
          <p set:html={markdownInlineToHtml(row.next)} />
        </section>
      ))
    }
  </div>

  <AnchorHeading level="2" id="memo">Memo</AnchorHeading>
  <div class="note-stack">
    {
      page.rows.map((row) => (
        <section class="note-panel">
          <strong set:html={markdownInlineToHtml(row.seed)} />
          <p set:html={markdownInlineToHtml(row.note)} />
        </section>
      ))
    }
  </div>
</StarlightPage>
