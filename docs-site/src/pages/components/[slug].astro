---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import DeviceQR from '../../components/DeviceQR.astro';
import PropsTable from '../../components/PropsTable.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import {
  componentPages,
  componentSidebar,
  hasMossyMatch,
  markdownInlineToHtml,
  type ComponentPage,
} from '../../data/seed-parity';

export function getStaticPaths() {
  return componentPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: ComponentPage;
}

const { page } = Astro.props;
const mossyRows = page.rows.filter(hasMossyMatch).length;
const exampleSources = import.meta.glob('../../../../example/src/examples/*.tsx', {
  eager: true,
  import: 'default',
  query: '?raw',
});
const exampleSource =
  exampleSources[`../../../../example/src/examples/${page.slug}.tsx`] as string | undefined;
const showDeviceQr = page.slug === 'box';
const boxTokenMappings = [
  {
    prop: '`bg`, `background`',
    seedType: '`ScopedColorPalette | ScopedColorBg | ScopedColorBanner | (string & {})`',
    mossyType: '`MossyBoxBackground`',
    mapping: 'Mossy `bg.*` / `banner.*` / raw string background token scope',
    docs: '/design-tokens/#color-token-scopes',
  },
  {
    prop: '`borderColor`',
    seedType: '`ScopedColorPalette | ScopedColorStroke | (string & {})`',
    mossyType: '`MossyBoxBorderColor`',
    mapping: 'Mossy `stroke.*` / raw string border token scope',
    docs: '/design-tokens/#color-token-scopes',
  },
  {
    prop: '`borderRadius`, corner radius props',
    seedType: '`Radius | 0 | (string & {})`',
    mossyType: '`MossyBoxRadiusToken | 0`',
    mapping: 'Mossy `r*` / `full` radius tokens',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`boxShadow`',
    seedType: '`Shadow | (string & {})`',
    mossyType: '`MossyBoxShadow`',
    mapping: 'Mossy `s*` shadow/elevation tokens',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`width`, `height`, min/max size props',
    seedType: '`Dimension | spacingX.* | spacingY.* | "full" | (string & {})`',
    mossyType: '`MossyBoxLength`',
    mapping: 'Mossy `x*` / `spacingX.*` / `spacingY.*` dimension tokens + `full`',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`padding*`, `p`, `px`, `py`, `pt`, `pr`, `pb`, `pl`, `gap`',
    seedType: '`Dimension | spacingX.* | spacingY.* | 0 | (string & {})`',
    mossyType: '`MossyBoxPadding`',
    mapping: 'Mossy `x*` / `spacingX.*` / `spacingY.*` dimension tokens',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`bgGradient`, `backgroundGradient`',
    seedType: '`Gradient`',
    mossyType: '`MossyBoxGradient`',
    mapping: 'Mossy gradient tokens (`fadeLayerFloating`, `glowMagic`, etc.)',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`bgGradientDirection`, `backgroundGradientDirection`',
    seedType: 'CSS gradient direction keywords / angle string',
    mossyType: '`MossyBoxGradientDirection`',
    mapping: 'CSS direction keywords and `${number}deg` converted to native gradient points',
    docs: '/design-tokens/#scale-tokens',
  },
];
const vStackTokenMappings = [
  {
    prop: '`bg`, `background`',
    seedType: '`ScopedColorPalette | ScopedColorBg | ScopedColorBanner | (string & {})`',
    mossyType: '`MossyBoxBackground`',
    mapping: 'Mossy `bg.*` / `banner.*` / raw string background token scope',
    docs: '/design-tokens/#color-token-scopes',
  },
  {
    prop: '`borderColor`',
    seedType: '`ScopedColorPalette | ScopedColorStroke | (string & {})`',
    mossyType: '`MossyBoxBorderColor`',
    mapping: 'Mossy `stroke.*` / raw string border token scope',
    docs: '/design-tokens/#color-token-scopes',
  },
  {
    prop: '`borderWidth`, directional border width props',
    seedType: '`0 | 1 | (string & {})`',
    mossyType: '`MossyBoxBorderWidth`',
    mapping: 'Mossy number dp / numeric string border width; arbitrary CSS length strings are constrained in the Props table',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`borderRadius`, corner radius props',
    seedType: '`Radius | 0 | (string & {})`',
    mossyType: '`MossyBoxRadiusToken | 0`',
    mapping: 'Mossy `r*` / `full` radius tokens; arbitrary CSS radius strings are constrained in the Props table',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`boxShadow`',
    seedType: '`Shadow | (string & {})`',
    mossyType: '`MossyBoxShadow`',
    mapping: 'Mossy `s*` shadow/elevation tokens; arbitrary CSS shadow strings are constrained in the Props table',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`width`, `height`',
    seedType: '`Dimension | spacingX.* | spacingY.* | "full" | (string & {})`',
    mossyType: '`MossyBoxLength`',
    mapping: 'Mossy `x*` / `spacingX.*` / `spacingY.*` dimension tokens + `full`; arbitrary CSS length strings are constrained in the Props table',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: 'min/max size props',
    seedType: '`Dimension | spacingX.* | spacingY.* | "full" | (string & {})`',
    mossyType: '`MossyVStackSizeConstraint`',
    mapping: 'Mossy `x*` / `spacingX.*` / `spacingY.*` dimension tokens; arbitrary CSS length strings and min/max `full` are constrained in the Props table',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`padding*`, `p`, `px`, `py`, `pt`, `pr`, `pb`, `pl`, `gap`',
    seedType: '`Dimension | spacingX.* | spacingY.* | 0 | (string & {})`',
    mossyType: '`MossyBoxPadding`',
    mapping: 'Mossy `x*` / `spacingX.*` / `spacingY.*` dimension tokens; arbitrary CSS length strings and `safeArea` are constrained in the Props table',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`bgGradient`, `backgroundGradient`',
    seedType: '`Gradient`',
    mossyType: '`MossyBoxGradient`',
    mapping: 'Mossy gradient tokens (`fadeLayerFloating`, `glowMagic`, etc.)',
    docs: '/design-tokens/#scale-tokens',
  },
  {
    prop: '`bgGradientDirection`, `backgroundGradientDirection`',
    seedType: 'CSS gradient direction keywords / angle string',
    mossyType: '`MossyBoxGradientDirection`',
    mapping: 'CSS direction keywords and `${number}deg` converted to native gradient points',
    docs: '/design-tokens/#scale-tokens',
  },
];
const floatTokenMappings = [
  {
    prop: '`offsetX`, `offsetY`',
    seedType: '`0 | Dimension | (string & {})`',
    mossyType: '`MossyFloatOffset`',
    mapping:
      'Mossy `x*` / `spacingX.*` / `spacingY.*` dimension tokens + number dp native offset; arbitrary CSS length strings are constrained in the Props table',
    docs: '/design-tokens/#scale-tokens',
  },
];
const tokenMappings =
  page.name === 'Box'
    ? [
        ...boxTokenMappings,
      ]
    : page.name === 'ZStack'
    ? [
        ...boxTokenMappings,
      ]
    : page.name === 'VStack'
    ? vStackTokenMappings
    : page.name === 'HStack'
    ? vStackTokenMappings.map((item) =>
        item.prop === 'min/max size props'
          ? { ...item, mossyType: '`MossyHStackSizeConstraint`' }
          : item,
      )
    : page.name === 'Flex'
    ? vStackTokenMappings.map((item) =>
        item.prop === 'min/max size props'
          ? { ...item, mossyType: '`MossyFlexSizeConstraint`' }
          : item,
      )
    : page.name === 'Grid'
    ? vStackTokenMappings.map((item) =>
        item.prop === 'min/max size props'
          ? { ...item, mossyType: '`MossyGridSizeConstraint`' }
          : item,
      )
    : page.name === 'Float'
    ? floatTokenMappings
    : [];
const tokenMappingGroups =
  page.name === 'Grid'
    ? [
        {
          component: 'Grid',
          mappings: vStackTokenMappings.map((item) =>
            item.prop === 'min/max size props'
              ? { ...item, mossyType: '`MossyGridSizeConstraint`' }
              : item,
          ),
        },
        {
          component: 'Grid.Item',
          mappings: vStackTokenMappings
            .filter((item) => item.prop !== '`padding*`, `p`, `px`, `py`, `pt`, `pr`, `pb`, `pl`, `gap`')
            .map((item) =>
              item.prop === 'min/max size props'
                ? { ...item, mossyType: '`MossyGridSizeConstraint`' }
                : item,
            )
            .concat([
              {
                prop: '`padding*`, `p`, `px`, `py`, `pt`, `pr`, `pb`, `pl`',
                seedType: '`Dimension | spacingX.* | spacingY.* | 0 | (string & {})`',
                mossyType: '`MossyBoxPadding`',
                mapping:
                  'Mossy `x*` / `spacingX.*` / `spacingY.*` dimension tokens; arbitrary CSS length strings and `safeArea` are constrained in the Props table',
                docs: '/design-tokens/#scale-tokens',
              },
            ]),
        },
      ]
    : tokenMappings.length > 0
    ? [{ component: page.name, mappings: tokenMappings }]
    : [];
const frontmatter = {
  title: page.name,
  description: `${page.name} Seed Design 참고 구현 대비 mossy-ui Props parity.`,
};
---

<StarlightPage
  frontmatter={frontmatter}
  sidebar={componentSidebar}
  headings={[
    ...(exampleSource != null ? [{ depth: 2 as const, slug: 'code', text: '코드' }] : []),
    { depth: 2, slug: 'props', text: 'Props' },
    ...(tokenMappingGroups.length > 0
      ? [{ depth: 2 as const, slug: 'seed-mossy-token-mapping', text: 'Seed ↔ Mossy token mapping' }]
      : []),
    { depth: 2, slug: 'next-action', text: 'Next Action' },
    { depth: 2, slug: 'memo', text: 'Memo' },
  ]}
>
  <div class="component-hero">
    <div>
      <p class="eyebrow">Expo UI component parity</p>
      <h1>{page.name}</h1>
      <p>
        {page.rows.length}개 checklist row · Mossy 대응 {mossyRows}/{page.rows.length} · props 완료{' '}
        {page.progress.done}/{page.progress.total}
      </p>
    </div>
    <StatusBadge status={page.status} />
  </div>

  {showDeviceQr ? <DeviceQR slug={page.slug} /> : null}

  {
    exampleSource != null ? (
      <>
        <AnchorHeading level="2" id="code">코드</AnchorHeading>
        <pre class="astro-code"><code>{exampleSource}</code></pre>
      </>
    ) : null
  }

  <AnchorHeading level="2" id="props">Props</AnchorHeading>
  <PropsTable rows={page.rows} />

  {
    tokenMappingGroups.length > 0 ? (
      <>
        <AnchorHeading level="2" id="seed-mossy-token-mapping">
          Seed ↔ Mossy token mapping
        </AnchorHeading>
        {tokenMappingGroups.map((group) => (
          <>
            <h3>{group.component}</h3>
            <div class="props-table-wrap">
              <table class="props-table token-mapping-table">
                <thead>
                  <tr>
                    <th>Prop</th>
                    <th>Seed type union</th>
                    <th>Mossy public type</th>
                    <th>Mossy token mapping</th>
                    <th>Token docs</th>
                  </tr>
                </thead>
                <tbody>
                  {group.mappings.map((item) => (
                    <tr>
                      <td set:html={markdownInlineToHtml(item.prop)} />
                      <td set:html={markdownInlineToHtml(item.seedType)} />
                      <td set:html={markdownInlineToHtml(item.mossyType)} />
                      <td set:html={markdownInlineToHtml(item.mapping)} />
                      <td>
                        <a href={item.docs}>/design-tokens/</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ))}
      </>
    ) : null
  }

  <AnchorHeading level="2" id="next-action">Next Action</AnchorHeading>
  <div class="note-stack">
    {
      page.rows.map((row) => (
        <section class="note-panel">
          <strong set:html={markdownInlineToHtml(row.seed)} />
          <p set:html={markdownInlineToHtml(row.next)} />
        </section>
      ))
    }
  </div>

  <AnchorHeading level="2" id="memo">Memo</AnchorHeading>
  <div class="note-stack">
    {
      page.rows.map((row) => (
        <section class="note-panel">
          <strong set:html={markdownInlineToHtml(row.seed)} />
          <p set:html={markdownInlineToHtml(row.note)} />
        </section>
      ))
    }
  </div>
</StarlightPage>
