---
import StatusBadge from './StatusBadge.astro';
import {
  markdownInlineToHtml,
  splitPropStatus,
  type ChecklistRow,
} from '../data/seed-parity';
import { propTableItems } from '../data/prop-table-items';

interface Props {
  rows: ChecklistRow[];
}

const { rows } = Astro.props;

const typeLinks: Record<string, string> = {
  ScopedColorPalette: '/design-tokens/#color-palette',
  ScopedColorBg: '/design-tokens/#color-token-scopes',
  ScopedColorFg: '/design-tokens/#color-token-scopes',
  ScopedColorStroke: '/design-tokens/#color-token-scopes',
  ScopedColorBanner: '/design-tokens/#color-token-scopes',
  Dimension: '/design-tokens/#scale-tokens',
  Radius: '/design-tokens/#scale-tokens',
  Shadow: '/design-tokens/#scale-tokens',
  FontSize: '/design-tokens/#scale-tokens',
  FontWeight: '/design-tokens/#scale-tokens',
  LineHeight: '/design-tokens/#scale-tokens',
};

function typeToHtml(value: string) {
  let html = escapeHtml(value);

  for (const [typeName, href] of Object.entries(typeLinks)) {
    html = html.replace(
      new RegExp(`\\b${typeName}\\b`, 'g'),
      `<a href="${href}">${typeName}</a>`
    );
  }

  return html;
}

function escapeHtml(value: string) {
  return value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
}
---

<div class="props-table-wrap">
  <table class="props-table">
    <thead>
      <tr>
        <th>Prop</th>
        <th>Type</th>
        <th>Status</th>
        <th>Note</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.flatMap((row) => {
          const items = splitPropStatus(row.propStatus);

          return items.flatMap((item) => propTableItems(row, item)).map((item) => (
            <tr>
              <td set:html={markdownInlineToHtml(item.prop)} />
              <td>{item.type === '-' ? '-' : <code set:html={typeToHtml(item.type)} />}</td>
              <td>
                {item.status ? <StatusBadge status={item.status} /> : '-'}
              </td>
              <td set:html={item.note ? markdownInlineToHtml(item.note) : '-'} />
            </tr>
          ));
        })
      }
    </tbody>
  </table>
</div>
